    def Scope "Looks"
    {
        def Material "wheel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:mdl:displacement.connect = </World/Looks/wheel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/wheel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/wheel/Shader.outputs:out>
            float physics:dynamicFriction = 2
            float physics:restitution = 0
            float physics:staticFriction = 2

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

    def "MyTerrain" (
        prepend payload = @./FinalTerrain/MyTerrain.usdc@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (3.120724024969485, 47.10000070184469, 49.100000731647015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Terrain_Collision"
        {
            uniform token purpose = "guide"

            over "Plane_001" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
            )
            {
                uniform token physics:approximation = "none"
                bool physics:collisionEnabled = 1
                int physxConvexDecompositionCollision:hullVertexLimit = 36
                int physxConvexDecompositionCollision:maxConvexHulls = 16
                uniform token purpose = "guide"
            }
        }

        over "env_light" (
            active = true
        )
        {
        }
    }

    def "small_KLT" (
        prepend payload = @../../../../../isaacsim_assets/Assets/Isaac/5.1/Isaac/Props/KLT_Bin/small_KLT.usd@
    )
    {
        float physics:mass = 10000
        float3 xformOp:rotateZYX = (0, 0, 0)
        float3 xformOp:scale = (30, 25, 6)
        double3 xformOp:translate = (11.536561297577538, -19.358501436662323, -0.29380085670167794)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

        over "DomeLight" (
            active = false
        )
        {
        }
    }
}

